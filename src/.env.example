# Строка подключения к Postgres. Обязательна.
DATABASE_URL=postgres://transcrib:transcrib@localhost:5432/transcrib?sslmode=disable

# Токен Telegram-бота. Обязателен.
BOT_TOKEN=

# Уровень структурных логов. Prod: info. Dev/test: debug при ручной диагностике.
LOG_LEVEL=info

# Переключатель поставщика транскрибации. Допустимые значения: mock (по умолчанию), speech2text, mymeet.
# Hot-swap: достаточно поменять значение и перезапустить. Пересборка не нужна.
TRANSCRIPTION_PROVIDER=mock

# Переключатель провайдера саммари (F3). Допустимые значения: off (по умолчанию), mock, openrouter.
# off — саммари вне скоупа: поток заканчивается доставкой транскрипта (демо-режим).
# openrouter — конспект формируем сами через OpenRouter (целевая реализация Summarizer).
SUMMARIZER_PROVIDER=off

# --- OpenRouter (провайдер саммари F3; docs/api/openrouter/API.md) ---
# Ключ openrouter.ai. Обязателен только при SUMMARIZER_PROVIDER=openrouter. Пустым
# оставлен намеренно: плейсхолдер прошёл бы валидацию и дал бы непонятный 401.
OPENROUTER_API_KEY=
# Slug модели саммари. Дефолт google/gemini-2.5-flash (1M контекст, дёшев). Свап без пересборки.
OPENROUTER_MODEL=google/gemini-2.5-flash
# Базовый URL API. Менять только при смене хоста.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Опциональный proxy только для OpenRouter. Не заменяет глобальный HTTPS_PROXY.
OPENROUTER_PROXY_URL=

# API-ключ speech2text.ru (https://api.speech2text.ru/profile-api), текущий prod/live-risk.
# Обязателен только при TRANSCRIPTION_PROVIDER=speech2text. Пустым оставлен
# намеренно: плейсхолдер-строка прошла бы валидацию и дала бы непонятный 401.
SPEECH2TEXT_API_KEY=

# Базовый URL API speech2text. Менять только при смене хоста (расхождение api.speech2text.ru
# vs speech2text.ru документировано в docs/api/speech2text/API.md §0).
SPEECH2TEXT_BASE_URL=https://api.speech2text.ru

# --- mymeet.ai (рабочий fallback; TRANSCRIPTION_PROVIDER=mymeet выбирает fallback) ---
# API-ключ mymeet.ai (заголовок X-API-KEY). Обязателен только при
# TRANSCRIPTION_PROVIDER=mymeet. Пустым оставлен намеренно: плейсхолдер прошёл бы
# валидацию и дал бы непонятный 401.
MYMEET_API_KEY=
# Базовый URL API mymeet. Менять только при смене хоста.
MYMEET_BASE_URL=https://backend.mymeet.ai
# Шаблон record-meeting (template_name). Саммари приходит только при шаблоне,
# который mymeet обрабатывает (default-meeting); при экзотическом шаблоне без
# саммари-секций SummaryMarkdown будет пустым -> юзер получит только транскрипт.
# При mymeet-саммари держать SUMMARIZER_PROVIDER=off: парсер рендерит его сам.
MYMEET_TEMPLATE=default-meeting
# Таймзона для local_date_time (валидное имя tzdata, напр. Europe/Moscow).
MYMEET_TIMEZONE=Europe/Moscow

# --- Квоты (F6, #7 hourly subscription) ---
# Лимит бесплатного триала в часах. Runtime хранит и считает минуты.
TRIAL_HOURS_LIMIT=3
# Часов в одном оплаченном периоде подписки.
SUBSCRIPTION_HOURS_PER_PERIOD=15
# Порог orphan/zombie-recovery (часы): recording старше — stop у provider и ожидание transcript.
# Защита от зависшей записи в постоянной комнате (Telemost). Дефолт 6.
JOB_MAX_AGE_HOURS=6
# Общий стартовый timeout (минуты): created/joining старше — auto-fail + рефанд.
# Защита от зависшего submit или бота, который не зашёл на встречу. 0 = выключено.
JOB_START_TIMEOUT_MINUTES=10
# Best-effort лимит Submit-попыток в памяти процесса. 0 = выключено.
JOB_SUBMIT_MAX_ATTEMPTS=3

# --- Оплата (F7, прямые ссылки ЮKassa) ---
# provider_token из BotFather оставлен только для legacy sendInvoice-тестов.
PROVIDER_TOKEN=
# Прямой REST API ЮKassa для создания платежей и refund'ов. ShopID/секрет выдаёт
# ЛК ЮKassa. Секрет не коммитить; пусто = реальная оплата выключена.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_BASE_URL=https://api.yookassa.ru/v3
# Куда ЮKassa вернёт пользователя после формы. Это UX-возврат, не подтверждение оплаты.
PAYMENT_RETURN_URL=https://transcrib.example.com/payments/return
# Как часто бот проверяет pending-платежи через GET /v3/payments/{id}.
# Этот же интервал использует worker автопродления, если включён.
PAYMENT_POLL_INTERVAL_SECONDS=30
# Merchant-initiated автосписания по сохранённому payment_method_id.
# Дефолт выключен: live-магазин ЮKassa должен быть подключён к автоплатежам менеджером.
RECURRING_PAYMENTS_ENABLED=false
# Цена подписки в КОПЕЙКАХ целым (199000 = 1990 ₽; brutto, НДС внутри). >0.
SUBSCRIPTION_PRICE_KOPECKS=199000
# Заголовок/описание инвойса (опц.; согласование названия — заказчик).
SUBSCRIPTION_TITLE=Подписка transcrib
SUBSCRIPTION_DESCRIPTION=15 часов на 1 месяц

# --- Чек 54-ФЗ (receipt в POST /v3/payments; api/yookassa/payment_links.md) ---
# Ставка НДС: 1 = «без НДС» (УСН/самозанятый). Под юр.форму заказчика.
RECEIPT_VAT_CODE=1
# Признак предмета/способа расчёта (FFD 1.05+; обязательны, иначе ЮKassa отклонит чек).
RECEIPT_PAYMENT_SUBJECT=service
RECEIPT_PAYMENT_MODE=full_payment
# Единица измерения для Чеков от ЮKassa / ФФД 1.2.
RECEIPT_MEASURE=piece
# Код системы налогообложения. ПУСТО/0 = поле в чек НЕ добавляем (при одной СНО
# отправка поля = ошибка фискализации). Задать только если у магазина несколько СНО.
RECEIPT_TAX_SYSTEM_CODE=
