# Postgres connection string. Required.
DATABASE_URL=postgres://transcrib:transcrib@localhost:5432/transcrib?sslmode=disable

# Telegram bot token. Required.
BOT_TOKEN=

# Structured log level. Prod: info. Dev/test: debug for manual diagnostics.
LOG_LEVEL=info

# Transcription provider switch. Allowed values: mock (default), speech2text, mymeet.
# Hot-swap: changing the value and restarting is enough. No rebuild needed.
TRANSCRIPTION_PROVIDER=mock

# Summary provider switch (F3). Allowed values: off (default), mock, openrouter.
# off - summary is out of scope: the flow ends with delivery of the transcript (demo mode).
# openrouter - we build the summary ourselves through OpenRouter (the target Summarizer implementation).
SUMMARIZER_PROVIDER=off

# --- OpenRouter (summary provider F3; docs/api/openrouter/API.md) ---
# openrouter.ai key. Required only with SUMMARIZER_PROVIDER=openrouter. Left empty
# on purpose: a placeholder would pass validation and give a confusing 401.
OPENROUTER_API_KEY=
# Summary model slug. Default google/gemini-2.5-flash (1M context, cheap). Swap without a rebuild.
OPENROUTER_MODEL=google/gemini-2.5-flash
# API base URL. Change only when the host changes.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional proxy for OpenRouter only. Does not replace the global HTTPS_PROXY.
OPENROUTER_PROXY_URL=

# speech2text.ru API key (https://api.speech2text.ru/profile-api), the current prod/live-risk.
# Required only with TRANSCRIPTION_PROVIDER=speech2text. Left empty
# on purpose: a placeholder string would pass validation and give a confusing 401.
SPEECH2TEXT_API_KEY=

# speech2text API base URL. Change only when the host changes (the discrepancy api.speech2text.ru
# vs speech2text.ru is documented in docs/api/speech2text/API.md §0).
SPEECH2TEXT_BASE_URL=https://api.speech2text.ru

# --- mymeet.ai (working fallback; TRANSCRIPTION_PROVIDER=mymeet selects the fallback) ---
# mymeet.ai API key (header X-API-KEY). Required only with
# TRANSCRIPTION_PROVIDER=mymeet. Left empty on purpose: a placeholder would pass
# validation and give a confusing 401.
MYMEET_API_KEY=
# mymeet API base URL. Change only when the host changes.
MYMEET_BASE_URL=https://backend.mymeet.ai
# record-meeting template (template_name). The summary arrives only with a template
# that mymeet processes (default-meeting); with an exotic template without
# summary sections SummaryMarkdown will be empty -> the user gets only the transcript.
# With the mymeet summary keep SUMMARIZER_PROVIDER=off: the parser renders it itself.
MYMEET_TEMPLATE=default-meeting
# Timezone for local_date_time (a valid tzdata name, e.g. Europe/Moscow).
MYMEET_TIMEZONE=Europe/Moscow

# --- Quotas (F6, #7 hourly subscription) ---
# Free trial limit in hours. The runtime stores and counts minutes.
TRIAL_HOURS_LIMIT=3
# Hours in one paid subscription period.
SUBSCRIPTION_HOURS_PER_PERIOD=15
# Orphan/zombie-recovery threshold (hours): a recording older than this gets stop at the provider and waits for the transcript.
# Protection against a stuck recording in a permanent room (Telemost). Default 6.
JOB_MAX_AGE_HOURS=6
# Common start timeout (minutes): created/joining older than this - auto-fail + refund.
# Protection against a stuck submit or a bot that did not join the meeting. 0 = disabled.
JOB_START_TIMEOUT_MINUTES=10
# Best-effort limit of Submit attempts in process memory. 0 = disabled.
JOB_SUBMIT_MAX_ATTEMPTS=3

# --- Payment (F7, direct YooKassa links) ---
# provider_token from BotFather is kept only for legacy sendInvoice tests.
PROVIDER_TOKEN=
# Direct YooKassa REST API for creating payments and refunds. ShopID/secret are issued by the
# YooKassa merchant account. Do not commit the secret; empty = real payment is disabled.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_BASE_URL=https://api.yookassa.ru/v3
# Where YooKassa returns the user after the form. This is a UX return, not payment confirmation.
PAYMENT_RETURN_URL=https://transcrib.example.com/payments/return
# How often the bot checks pending payments through GET /v3/payments/{id}.
# The same interval is used by the recurring payment worker, if enabled.
PAYMENT_POLL_INTERVAL_SECONDS=30
# Merchant-initiated recurring charges by the saved payment_method_id.
# Disabled by default: the live YooKassa shop must be connected to recurring payments by a manager.
RECURRING_PAYMENTS_ENABLED=false
# Subscription price in whole KOPECKS (199000 = 1990 RUB; gross, VAT included). >0.
SUBSCRIPTION_PRICE_KOPECKS=199000
# Invoice title/description (optional; the title wording is agreed with the customer).
# These are user-facing texts, kept in Russian on purpose.
SUBSCRIPTION_TITLE=Подписка transcrib
SUBSCRIPTION_DESCRIPTION=15 часов на 1 месяц

# --- 54-FZ receipt (receipt in POST /v3/payments; api/yookassa/payment_links.md) ---
# VAT rate: 1 = "no VAT" (simplified tax system/self-employed). Matches the customer's legal form.
RECEIPT_VAT_CODE=1
# Payment subject / payment mode (FFD 1.05+; mandatory, otherwise YooKassa rejects the receipt).
RECEIPT_PAYMENT_SUBJECT=service
RECEIPT_PAYMENT_MODE=full_payment
# Unit of measure for YooKassa receipts / FFD 1.2.
RECEIPT_MEASURE=piece
# Tax system code. EMPTY/0 = the field is NOT added to the receipt (with a single tax system
# sending the field = fiscalization error). Set only if the shop has several tax systems.
RECEIPT_TAX_SYSTEM_CODE=
